# Local settings: copy to .env.local (git ignores it) and restart `npm run dev`.

# --- Scheduler (#book) · LunaCal ------------------------------------------------
# API key: app.lunacal.ai → Settings → Developer → Create API key (shown once).
LUNACAL_API_KEY=
# Numeric id of the event type the calendar books (the "Free automation audit" event).
# List them with:
#   curl -X POST https://app.lunacal.ai/api/event-types/list \
#     -H "Authorization: Bearer $LUNACAL_API_KEY" -H "Content-Type: application/json" -d '{}'
LUNACAL_EVENT_TYPE_ID=
# Optional: another LunaCal host (defaults to https://app.lunacal.ai).
# LUNACAL_API_BASE=

# --- Form delivery --------------------------------------------------------------
# Where "Write to us instead" (#book) and "Email me this estimate" (#calculator) are
# posted as JSON: a Zapier/Make hook, a Slack or Teams incoming webhook, a CRM endpoint.
BOOK_WEBHOOK_URL=
