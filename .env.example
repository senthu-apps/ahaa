# Local settings: copy to .env.local (git ignores it) and restart `npm run dev`.

# --- Scheduler (#book) · LunaCal ------------------------------------------------
# API key: app.lunacal.ai → Settings → Developer → Create API key (shown once).
LUNACAL_API_KEY=
# Numeric id of the event type the calendar books (the "Free automation audit" event).
# List them with:
#   curl -X POST https://app.lunacal.ai/api/event-types/list \
#     -H "Authorization: Bearer $LUNACAL_API_KEY" -H "Content-Type: application/json" -d '{}'
LUNACAL_EVENT_TYPE_ID=
# Optional: another LunaCal host (defaults to https://app.lunacal.ai).
# LUNACAL_API_BASE=

# --- Form delivery · Resend -----------------------------------------------------
# "Write to us instead" (#book) and "Email me this estimate" (#calculator) are sent by
# email through Resend (/api/book). Without the key and MAIL_TO, development logs the
# request and production answers 503.
# API key: resend.com → API Keys → Create API key (sending access is enough).
RESEND_API_KEY=
# The inbox that receives the requests, e.g. hello@aiweavers.com
MAIL_TO=
# The sender, on a domain verified in Resend (Domains → Add domain → the DNS records it lists).
# Until the domain is verified, the default sender onboarding@resend.dev can only deliver
# to the Resend account's own email address.
# MAIL_FROM=AI Weavers <hello@aiweavers.com>
